# Copy to .env. These are baked into the built HTML and are NOT secrets.
# Leave them empty and the site simply ships without Turnstile and without
# analytics, with no third-party requests at all.

# Cloudflare Turnstile site key (invisible / interaction-only mode).
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics beacon token. Loaded after `load`, no cookies.
PUBLIC_CF_ANALYTICS_TOKEN=

# Canonical origin. Change this the day the domain is live.
SITE_URL=https://zista.health
