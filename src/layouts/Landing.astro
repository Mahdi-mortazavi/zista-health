---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Gap from '../components/Gap.astro';
import Journey from '../components/Journey.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Signals from '../components/Signals.astro';
import Status from '../components/Status.astro';
import Paths from '../components/Paths.astro';
import Investors from '../components/Investors.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import FloatingBar from '../components/FloatingBar.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';
import type { Copy } from '../content/types';

interface Props {
  copy: Copy;
  path: string;
}
const { copy, path } = Astro.props;
---

<BaseLayout copy={copy} path={path} landing>
  <Nav copy={copy} />
  <main id="main">
    <Hero copy={copy} />
    <Gap copy={copy} />
    <HowItWorks copy={copy} />
    <Journey copy={copy} />
    <Signals copy={copy} />
    <Status copy={copy} />
    <Paths copy={copy} />
    <Investors copy={copy} />
    <Faq copy={copy} />
    <Contact copy={copy} />
  </main>
  <Footer copy={copy} />
  <FloatingBar copy={copy} />
  <Reveal />
</BaseLayout>
