---
interface Props {
  label: string;
}
const { label } = Astro.props;

// A photoplethysmogram-shaped beat: sharp systolic upstroke, fall, dicrotic
// notch, slow diastolic decay. Eight beats are drawn, four are visible, and the
// element translates by exactly four, so the loop has no seam. Four across the
// viewport keeps the pulse legible at 390px and at 1440px alike.
const W = 200;
const beat = (x: number) =>
  `C${x + 10},100 ${x + 14},100 ${x + 20},98 ` +
  `C${x + 28},94 ${x + 32},40 ${x + 46},30 ` +
  `C${x + 58},22 ${x + 62},52 ${x + 72},66 ` +
  `C${x + 80},77 ${x + 84},74 ${x + 92},66 ` +
  `C${x + 100},58 ${x + 106},60 ${x + 114},70 ` +
  `C${x + 126},84 ${x + 140},96 ${x + 160},99 ` +
  `C${x + 176},101 ${x + 190},100 ${x + W},100`;

const d = `M0,100 ${Array.from({ length: 8 }, (_, i) => beat(i * W)).join(' ')}`;
---

<div class="wave" role="img" aria-label={label}>
  <svg viewBox="0 0 800 200" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="fade" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.18" stop-color="#fff" stop-opacity="1" />
        <stop offset="0.82" stop-color="#fff" stop-opacity="1" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </linearGradient>
      <mask id="fademask">
        <rect x="0" y="0" width="800" height="200" fill="url(#fade)" />
      </mask>
    </defs>
    <g mask="url(#fademask)">
      <path class="trace ghost" d={d} />
      <path class="trace" d={d} />
    </g>
  </svg>
</div>

<style>
  .wave {
    inline-size: 100%;
    aspect-ratio: 1000 / 250;
    max-block-size: 220px;
    overflow: hidden;
    contain: paint;
  }

  svg {
    inline-size: 100%;
    block-size: 100%;
    display: block;
  }

  .trace {
    fill: none;
    stroke: var(--color-tint);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    animation: drift 4.8s linear infinite;
  }

  .ghost {
    stroke: var(--color-tint);
    opacity: 0.16;
    stroke-width: 8;
    animation-delay: -0.06s;
  }

  @keyframes drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-800px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace {
      animation: none;
      transform: translateX(-260px);
    }
  }
</style>
