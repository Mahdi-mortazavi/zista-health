---
import type { Copy } from '../content/types';

interface Props {
  copy: Copy;
}
const { copy: c } = Astro.props;
---

<section class="section gap" id="gap" aria-labelledby="gap-h">
  <div class="wrap">
    <p class="eyebrow reveal">{c.gap.eyebrow}</p>
    <h2 class="t-title-1 measure reveal" id="gap-h">{c.gap.h2}</h2>

    <ol class="beats">
      {c.gap.beats.map((b, i) => (
        <li class="beat reveal" style={`--d:${i * 60}ms`}>
          <h3 class="t-title-3">{b.title}</h3>
          <p class="t-body body">{b.body}</p>
        </li>
      ))}
    </ol>

    <figure class="scenario reveal">
      <figcaption class="scenario-label">{c.gap.scenarioLabel}</figcaption>
      <blockquote><p>{c.gap.scenario}</p></blockquote>
    </figure>
  </div>
</section>

<style>
  .gap {
    background: var(--color-bg-primary);
    border-block-start: 1px solid var(--color-separator);
  }

  h2 {
    margin: 0.75rem 0 0;
  }

  .beats {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }

  .beat {
    transition-delay: var(--d, 0ms);
    padding-inline-start: 1.125rem;
    border-inline-start: 2px solid var(--color-tint);
  }

  .beat h3 {
    margin: 0 0 0.5rem;
  }

  .body {
    margin: 0;
    color: var(--color-label-2);
    max-width: var(--measure);
  }

  .scenario {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-card);
    max-width: var(--measure);
  }

  .scenario-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-label-2);
    margin-block-end: 0.75rem;
  }

  :global(html[lang='fa']) .scenario-label {
    letter-spacing: 0;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    margin: 0;
    font-size: 1.0625rem;
  }

  @media (min-width: 62rem) {
    .beats {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
</style>
