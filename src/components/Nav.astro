---
import type { Copy } from '../content/types';
import Icons from './Icons.astro';

interface Props {
  copy: Copy;
}
const { copy: c } = Astro.props;
---

<header class="nav-shell no-print">
  <nav class="nav glass" aria-label={c.brand.legalName}>
    <a class="brand" href={c.locale === 'fa' ? '/' : '/en/'}>
      <span class="mark" aria-hidden="true"><Icons name="ring" size={22} /></span>
      <span class="brand-name">{c.brand.name}</span>
      <span class="visually-hidden">{c.brand.legalName}</span>
    </a>

    <ul class="links" aria-label={c.nav.menu}>
      {c.nav.links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>

    <a class="lang" href={c.nav.langSwitchHref} hreflang={c.locale === 'fa' ? 'en' : 'fa'} lang={c.locale === 'fa' ? 'en' : 'fa'}>
      {c.nav.langSwitch}
    </a>
  </nav>
</header>

<style>
  .nav-shell {
    position: sticky;
    inset-block-start: 0;
    z-index: 40;
    padding: 0.625rem clamp(0.75rem, 4vw, 1.5rem) 0;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: 0.875rem;
    border-radius: var(--radius-glass);
    min-height: 52px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 680;
    letter-spacing: -0.02em;
    color: var(--color-label-1);
    padding-inline-end: 0.25rem;
  }

  :global(html[lang='fa']) .brand {
    letter-spacing: 0;
  }

  .mark {
    color: var(--color-tint);
    display: inline-flex;
  }

  .brand-name {
    font-size: 1.0625rem;
  }

  .links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
    margin-inline-start: auto;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    padding-inline: 0.625rem;
    font-size: 0.875rem;
    color: var(--color-label-2);
    text-decoration: none;
    border-radius: var(--radius-control);
    transition: color 0.3s var(--ease-spring);
  }

  .links a:hover {
    color: var(--color-label-1);
  }

  .lang {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.875rem;
    min-width: 44px;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-tint);
    text-decoration: none;
    border: 1px solid var(--color-separator);
    border-radius: var(--radius-control);
  }

  @media (min-width: 64rem) {
    .links {
      display: flex;
    }
    .lang {
      margin-inline-start: 0.5rem;
    }
  }
</style>
