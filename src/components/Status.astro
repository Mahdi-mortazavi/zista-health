---
import type { Copy } from '../content/types';

interface Props {
  copy: Copy;
}
const { copy: c } = Astro.props;
---

<section class="section status" id="status" aria-labelledby="status-h">
  <div class="wrap">
    <p class="eyebrow reveal">{c.status.eyebrow}</p>
    <h2 class="h2 measure reveal" id="status-h">{c.status.h2}</h2>
    <p class="lead measure reveal intro">{c.status.intro}</p>

    <dl class="rows">
      {c.status.rows.map((r, i) => (
        <div class="row reveal" style={`--d:${i * 45}ms`}>
          <dt class="h3">{r.title}</dt>
          <dd class="body">{r.body}</dd>
        </div>
      ))}
    </dl>

    <p class="closing reveal">{c.status.closing}</p>
  </div>
</section>

<style>
  .status {
    background: var(--color-bg-primary);
    border-block: 1px solid var(--color-separator);
  }

  h2 {
    margin: 0.75rem 0 0;
  }

  .intro {
    margin-block: 1.25rem 0;
  }

  .rows {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    display: grid;
    gap: 0;
  }

  .row {
    padding-block: 1.5rem;
    border-block-start: 1px solid var(--color-separator);
    transition-delay: var(--d, 0ms);
  }

  .row:last-child {
    border-block-end: 1px solid var(--color-separator);
  }

  dt {
    margin: 0 0 0.5rem;
  }

  dd {
    margin: 0;
    color: var(--color-label-2);
    max-width: var(--measure);
  }

  .closing {
    margin: 2rem 0 0;
    max-width: var(--measure);
    font-weight: 620;
  }

  @media (min-width: 48rem) {
    .row {
      display: grid;
      grid-template-columns: minmax(14rem, 20rem) 1fr;
      gap: 2rem;
      align-items: start;
    }
  }
</style>
